{
  "name": "offers-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Telegram-бот коммерческих предложений (LogicTEAM.КП): вход по e-mail и коду, сборка КП из каталога, выдача DOCX.",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/bot.mjs --banner:js=\"import{createRequire as __createRequire}from 'module';const require=__createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "start": "node dist/bot.mjs",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "socks-proxy-agent": "^8.0.5",
    "typescript": "~5.6.3"
  }
}
