# Бот коммерческих предложений (LogicTEAM.КП).
# С VDS в РФ прямого пути к IP Telegram нет (диапазоны AS62041 заблокированы
# на уровне хостера), поэтому запросы идут через SOCKS5-туннель nl-egress-proxy.
# В проде TELEGRAM_SOCKS_PROXY задаётся через environment: сервиса — сайдкар
# offers-nl-proxy на той же docker-сети (см. docker-compose). Значение 127.0.0.1
# годится только при запуске вне Docker, где ssh -D слушает на localhost.
TELEGRAM_SOCKS_PROXY=socks5://127.0.0.1:1080

# Токен бота из @BotFather. Пусто — поллер не стартует.
TELEGRAM_BOT_TOKEN=

# Внутренний адрес offers-service и секрет, которым защищены ручки /api/offers/bot/*.
OFFERS_API_URL=http://offers:3000
OFFERS_BOT_SECRET=

# Лимит сообщений в минуту на один чат.
OFFERS_BOT_RATE_LIMIT=30
